+#ifdef M_CORE_GB
+/* The six mLockstep callbacks, on one thread. mgba's own MultiplayerController (Qt) is the
+ * reference; every mCoreThreadWaitFromThread there becomes `asleep = true` here and every
+ * mCoreThreadStopWaiting becomes `asleep = false`. Nothing else about them changes, deliberately:
+ * the credit arithmetic decides emulated timing, and two SPs running different arithmetic would
+ * part company. */
+static struct LinkGB* _gbPlayer(int id) {
+	return (struct LinkGB*) gbLockstep.players[id];
+}
+
+/* Fail closed when the linked GB core stops making progress within a
+ * single native runLoop call. The Rust cable runner already tests
+ * slot_mgba_gb_link_fault() before accepting the frame. */
+__attribute__((visibility("hidden"))) void slot_mgba_gb_link_mark_fault(void) {
+	if (!linkMode || !linkPlugged || !core ||
+	    core->platform(core) != mPLATFORM_GB) return;
+	linkStuck = true;
+#ifdef __ANDROID__
+	__android_log_print(ANDROID_LOG_ERROR, "SlotKONKR",
+		"GB Link inner loop ended: phase=%d asleep=%d/%d mask=%u credits=%d/%d eventDiff=%d/%d nextEvent=%d/%d",
+		gbLockstep.d.transferActive,
+		linkGb[0].asleep, linkGb[1].asleep,
+		_gbPlayer(0)->waitMask,
+		linkGb[0].cyclesPosted, linkGb[1].cyclesPosted,
+		linkGb[0].node.eventDiff, linkGb[1].node.eventDiff,
+		linkGb[0].node.nextEvent, linkGb[1].node.nextEvent);
+#endif
+}
+
+/* Only the master ever waits, and only on the slaves named in the mask. */
+static bool _gbWait(struct mLockstep* lockstep, unsigned mask) {
+	UNUSED(lockstep);
+	struct LinkGB* master = _gbPlayer(0);
+	master->waitMask |= mask;
+	/* Always true. False here is an abort() in _masterUpdate, and on one thread the master is
+	 * running whenever it asks, so "yes, you are now asleep" is the truthful answer. */
+	master->asleep = true;
+	return true;
+}
+
+/* A slave telling the master it has caught up. */
+static bool _gbSignal(struct mLockstep* lockstep, unsigned mask) {
+	UNUSED(lockstep);
+	struct LinkGB* master = _gbPlayer(0);
+	master->waitMask &= ~mask;
+	if (!master->waitMask && master->asleep) {
+		master->asleep = false;
+		return true;
+	}
+	return false;
+}
+
+/* id 0 credits the *slave* with the cycles the master has just run, and wakes it; a slave credits
+ * itself. This is upstream's asymmetry, not a typo (MultiplayerController.cpp:104-113). */
+static void _gbAddCycles(struct mLockstep* lockstep, int id, int32_t cycles) {
+	UNUSED(lockstep);
+	struct LinkGB* player;
+	if (!id) {
+		player = _gbPlayer(1);
+		player->cyclesPosted += cycles;
+		if (player->asleep) {
+			player->node.nextEvent += player->cyclesPosted;
+			player->asleep = false;
+		}
+	} else {
+		player = _gbPlayer(id);
+		player->cyclesPosted += cycles;
+	}
+}
+
+static int32_t _gbUseCycles(struct mLockstep* lockstep, int id, int32_t cycles) {
+	UNUSED(lockstep);
+	struct LinkGB* player = _gbPlayer(id);
+	player->cyclesPosted -= cycles;
+	if (player->cyclesPosted <= 0) {
+		player->asleep = true;
+	}
+	return player->cyclesPosted;
+}
+
+static int32_t _gbUnusedCycles(struct mLockstep* lockstep, int id) {
+	UNUSED(lockstep);
+	return _gbPlayer(id)->cyclesPosted;
+}
+
+/* Every one of the six must be set before a node is attached: mLockstepInit leaves four of them
+ * as whatever was in the struct, and GBSIOLockstepNodeDeinit calls unload() on the first unplug. */
+static void _gbUnload(struct mLockstep* lockstep, int id) {
+	UNUSED(lockstep);
+	if (id) {
+		_gbPlayer(id)->cyclesPosted = 0;
+		struct LinkGB* master = _gbPlayer(0);
+		master->waitMask &= ~(1u << id);
+		if (!master->waitMask && master->asleep) {
+			master->asleep = false;
+		}
+	} else {
+		int i;
+		for (i = 1; i < gbLockstep.d.attached; ++i) {
+			struct LinkGB* player = _gbPlayer(i);
+			player->cyclesPosted += gbLockstep.players[0]->eventDiff;
+			if (player->asleep) {
+				player->node.nextEvent += player->cyclesPosted;
+				player->asleep = false;
+			}
+		}
+	}
+}
+
+/* The Game Boy has no link peripheral , include/mgba/gba/interface.h has mPERIPH_GBA_LINK_PORT
+ * and there is no GB analogue, and _GBCoreSetPeripheral ignores anything it does not know. So the
+ * cable goes in the way mgba's own Qt frontend puts it in: reach past the core for the board and
+ * call GBSIOSetDriver. */
+static void _linkPlugInGB(void) {
+	int i;
+	memset(&gbLockstep, 0, sizeof(gbLockstep));
+	mLockstepInit(&gbLockstep.d);
+	GBSIOLockstepInit(&gbLockstep);
+	gbLockstep.d.wait = _gbWait;
+	gbLockstep.d.signal = _gbSignal;
+	gbLockstep.d.addCycles = _gbAddCycles;
+	gbLockstep.d.useCycles = _gbUseCycles;
+	gbLockstep.d.unusedCycles = _gbUnusedCycles;
+	gbLockstep.d.unload = _gbUnload;
+	for (i = 0; i < 2; ++i) {
+		struct LinkGB* player = &linkGb[i];
+		player->asleep = false;
+		player->cyclesPosted = 0;
+		player->waitMask = 0;
+		memset(&player->node, 0, sizeof(player->node));
+		GBSIOLockstepNodeCreate(&player->node);
+		GBSIOLockstepAttachNode(&gbLockstep, &player->node);
+		GBSIOSetDriver(&((struct GB*) player->core->board)->sio, &player->node.d);
+	}
+	linkPlugged = true;
+	linkStuck = false;
+	_gbDiagStart();
+}
+
+static void _linkUnplugGB(void) {
+	_gbDiagStop();
+	int i;
+	for (i = 0; i < 2; ++i) {
+		/* GBSIOSetDriver deinits the old driver, which is what detaches the node. */
+		GBSIOSetDriver(&((struct GB*) linkGb[i].core->board)->sio, NULL);
+		GBSIOLockstepDetachNode(&gbLockstep, &linkGb[i].node);
+	}
+	mLockstepDeinit(&gbLockstep.d);
+	linkPlugged = false;
+}
+
+/* Steps both Game Boys one video frame, taking turns on this thread. The rule is the GBA's: run
+ * whichever console is awake and short of its frame, and let a console that has finished keep
+ * running only while the other sleeps , which for the Game Boy is how the slave is paid, since the
+ * master's _masterUpdate credits it with addCycles(0, eventDiff) every 512 units.
+ *
+ * Plan 1's finished-player-0 special case is deliberately NOT ported. That fires the GBA
+ * coordinator's event early to sync at a frame boundary; the Game Boy's credit scheduler
+ * distributes slack differently and the stall it fixes may not exist here. Reproduce the stall
+ * before porting the fix. */
+/* The linked GB scheduler runs on the Android GL thread. A missing lockstep
+ * wakeup must never spin without bound or freeze the whole application.
+ * The Rust cable runner observes this error and refuses to advance an
+ * incomplete emulation frame or commit its save to SOLO. */
+__attribute__((visibility("default"))) uint32_t slot_mgba_gb_link_fault(void) {
+	return linkMode && core && core->platform(core) == mPLATFORM_GB && linkStuck ? 1 : 0;
+}
+
+static void _linkStepGB(void) {
+	uint32_t target[2];
+	uint32_t start[2];
+	bool done[2] = { false, false };
+	struct timespec began, now;
+	clock_gettime(CLOCK_MONOTONIC, &began);
+	unsigned iterations = 0;
+	int i;
+	for (i = 0; i < 2; ++i) {
+		struct GB* gb = linkGb[i].core->board;
+		target[i] = gb->video.frameCounter + 1;
+		start[i] = mTimingCurrentTime(&gb->timing);
+	}
+	_gbDiagMark(1, 0, iterations);
+	while (!done[0] || !done[1]) {
+		/* Sparse wall-clock reads have no effect on ordinary 60Hz frames.
+		 * 500ms / 200k iterations are failure bounds, not frame pacing. */
+		if (++iterations >= 200000 || ((iterations & 1023u) == 0 &&
+			(clock_gettime(CLOCK_MONOTONIC, &now) != 0 ||
+			 ((int64_t)(now.tv_sec - began.tv_sec) * 1000 +
+			  (now.tv_nsec - began.tv_nsec) / 1000000) >= 500))) {
+			linkStuck = true;
+			_gbDiagMark(5, 0, iterations);
+			fprintf(stderr, "mgba: GB Link frame watchdog: iterations=%u asleep=%d/%d done=%d/%d\\n",
+				iterations, linkGb[0].asleep, linkGb[1].asleep, done[0], done[1]);
+			return;
+		}
+		bool ran = false;
+		for (i = 0; i < 2; ++i) {
+			struct LinkGB* self = &linkGb[i];
+			struct LinkGB* other = &linkGb[1 - i];
+			if (self->asleep) {
+				continue;
+			}
+			if (done[i] && (done[1 - i] || !other->asleep)) {
+				continue;
+			}
+			struct GB* gb = self->core->board;
+			_gbDiagMark(2, (unsigned) i, iterations);
+			self->core->runLoop(self->core);
+			if (linkStuck) {
+				_gbDiagMark(5, (unsigned) i, iterations);
+				return; /* Incomplete paired frame is not playable. */
+			}
+			_gbDiagMark(3, (unsigned) i, iterations);
+			ran = true;
+			if (gb->video.frameCounter >= target[i] ||
+			    (uint32_t) mTimingCurrentTime(&gb->timing) - start[i] >=
+			        (GB_VIDEO_TOTAL_LENGTH + GB_VIDEO_HORIZONTAL_LENGTH) * 2) {
+				done[i] = true;
+			}
+		}
+		if (!ran) {
+			if (!linkStuck) {
+				fprintf(stderr, "mgba: link: neither GB can run (asleep %d/%d, done %d/%d)\n",
+				        linkGb[0].asleep, linkGb[1].asleep, done[0], done[1]);
+				linkStuck = true;
+			}
+			_gbDiagMark(5, 0, iterations);
+			return;
+		}
+	}
+#ifdef __ANDROID__
+	++gbDiagCompleted;
+#endif
+	_gbDiagMark(4, 0, iterations);
+}
+#endif
