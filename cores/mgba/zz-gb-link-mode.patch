+#ifdef M_CORE_GB
+/* The Game Boy half of link mode, and it is a different machine from the GBA's. GBSIOLockstep is
+ * the pre-2024 mLockstep API: the frontend supplies six scheduling callbacks, the master is
+ * expected to *block* inside wait(), and _masterUpdate abort()s if wait() says it did not. On one
+ * thread nothing can block, so wait() records the sleep and returns true , which is the honest
+ * answer, since the master is by definition running when it asks.
+ *
+ * Savestates are not done. A Game Boy state carries no serial section, and link-mode savestates
+ * are still the GBA's SLK1 container, so a session's state swap has nothing to hand over yet.
+ * Measured on an H700: 3.802 ms for a linked Game Boy pair, 2.661 ms for a linked Colour pair,
+ * against a 16.743 ms frame. */
+struct LinkGB {
+	struct GBSIOLockstepNode node; /* first, so lockstep.players[id] is a struct LinkGB* */
+	struct mCore* core;
+	bool asleep;
+	int32_t cyclesPosted;
+	unsigned waitMask;
+};
+
+/* Indexed by player: linkGb[linkPlayer].core is `core`. Scheduling state lives with the console,
+ * and is reached by node id through lockstep.players[], because GBSIOLockstepNodeWriteSC swaps
+ * the two nodes' ids at runtime whenever the console that claims the clock is not node 0. */
+static struct LinkGB linkGb[2];
+static struct GBSIOLockstep gbLockstep;
+
+/* The stock non-root KPA disallows debuggerd native stacks. This Android-
+ * only observer samples an ATOMIC COPY of the lockstep state, never live GB
+ * objects. It runs on an independent thread when the GL thread is spinning
+ * inside SM83Run(), where our original outer 500ms watchdog cannot execute.
+ * Diagnostic only: never changes emulated CPU credits or serial scheduling. */
+#ifdef __ANDROID__
+static uint64_t gbDiagSnapshot;
+static uint64_t gbDiagInnerSnapshot;
+static uint32_t gbDiagInnerSeq;
+static uint32_t gbDiagGeneration;
+static uint32_t gbDiagCompleted;
+
+/* Inner-core trace hook. Events and CPU progress are sampled by the
+ * independent monitor. These atomics are written by only the GL thread,
+ * even when that thread is permanently stuck inside mTimingTick(). */
+__attribute__((visibility("hidden"))) void slot_mgba_gb_link_inner_trace(
+	unsigned kind, unsigned arg, unsigned value) {
+	if (!linkMode || !linkPlugged || !core ||
+	    core->platform(core) != mPLATFORM_GB) {
+		return;
+	}
+	uint32_t seq = ++gbDiagInnerSeq;
+	uint64_t word = ((uint64_t) (kind & 0xff) << 56)
+		| ((uint64_t) (arg & 0xffff) << 40)
+		| ((uint64_t) (value & 0xffff) << 24)
+		| (seq & 0xffffff);
+	__atomic_store_n(&gbDiagInnerSnapshot, word, __ATOMIC_RELEASE);
+}
+
+/* 64-bit snapshot:
+ * [63:32] completed linked frames; [31:16] iteration;
+ * [15:12] transfer phase; [11:10] active player;
+ * [9:8] sleeping players; [3:0] stage (1 start, 2 entering
+ * runLoop, 3 returned, 4 finished, 5 scheduler fault).
+ * Only the emulator thread writes these values. The observer reads the
+ * immutable snapshot atomically, avoiding cross-thread C data races. */
+static void _gbDiagMark(unsigned stage, unsigned player, unsigned iter) {
+	uint64_t word = ((uint64_t) gbDiagCompleted << 32)
+		| ((uint64_t) (iter & 0xffff) << 16)
+		| ((uint64_t) (gbLockstep.d.transferActive & 15) << 12)
+		| ((uint64_t) (player & 3) << 10)
+		| ((uint64_t) (linkGb[0].asleep ? 1 : 0) << 8)
+		| ((uint64_t) (linkGb[1].asleep ? 1 : 0) << 9)
+		| stage;
+	__atomic_store_n(&gbDiagSnapshot, word, __ATOMIC_RELEASE);
+}
+
+static void* _gbDiagMonitor(void* opaque) {
+	uint32_t generation = (uint32_t) (uintptr_t) opaque;
+	uint32_t lastCompleted = 0;
+	unsigned stagnant = 0;
+	const struct timespec quarter = { 0, 250000000 };
+	while (__atomic_load_n(&gbDiagGeneration, __ATOMIC_ACQUIRE) == generation) {
+		nanosleep(&quarter, NULL);
+		if (__atomic_load_n(&gbDiagGeneration, __ATOMIC_ACQUIRE) != generation) {
+			break;
+		}
+		uint64_t status = __atomic_load_n(&gbDiagSnapshot, __ATOMIC_ACQUIRE);
+		unsigned stage = (unsigned) (status & 15);
+		uint32_t completed = (uint32_t) (status >> 32);
+		if (stage == 0 || stage == 4 || completed != lastCompleted) {
+			lastCompleted = completed;
+			stagnant = 0;
+			continue;
+		}
+		if (++stagnant >= 8 && (stagnant == 8 || (stagnant % 8) == 0)) {
+			uint64_t inner = __atomic_load_n(&gbDiagInnerSnapshot, __ATOMIC_ACQUIRE);
+			__android_log_print(ANDROID_LOG_ERROR, "SlotKONKR",
+				"GB Link CPU stall: duration_ms=%u frame=%u stage=%u player=%u phase=%u asleep=%u/%u iter=%u session=%u inner_kind=%u inner_arg=%u inner_value=%u inner_seq=%u",
+				stagnant * 250, completed, stage,
+				(unsigned) ((status >> 10) & 3),
+				(unsigned) ((status >> 12) & 15),
+				(unsigned) ((status >> 8) & 1),
+				(unsigned) ((status >> 9) & 1),
+				(unsigned) ((status >> 16) & 0xffff), generation,
+				(unsigned) ((inner >> 56) & 0xff),
+				(unsigned) ((inner >> 40) & 0xffff),
+				(unsigned) ((inner >> 24) & 0xffff),
+				(unsigned) (inner & 0xffffff));
+		}
+	}
+	return NULL;
+}
+
+static void _gbDiagStart(void) {
+	gbDiagCompleted = 0;
+	gbDiagInnerSeq = 0;
+	__atomic_store_n(&gbDiagSnapshot, 0, __ATOMIC_RELEASE);
+	__atomic_store_n(&gbDiagInnerSnapshot, 0, __ATOMIC_RELEASE);
+	uint32_t generation = __atomic_add_fetch(&gbDiagGeneration, 1, __ATOMIC_ACQ_REL);
+	pthread_t watcher;
+	int rc = pthread_create(&watcher, NULL, _gbDiagMonitor,
+		(void*) (uintptr_t) generation);
+	if (rc == 0) {
+		pthread_detach(watcher);
+	}
+	__android_log_print(ANDROID_LOG_INFO, "SlotKONKR",
+		"GB Link diagnostic monitor: generation=%u thread_result=%d",
+		generation, rc);
+}
+
+static void _gbDiagStop(void) {
+	__atomic_add_fetch(&gbDiagGeneration, 1, __ATOMIC_ACQ_REL);
+	__atomic_store_n(&gbDiagSnapshot, 0, __ATOMIC_RELEASE);
+}
+#else
+#define _gbDiagMark(stage, player, iter) ((void) 0)
+#define _gbDiagStart() ((void) 0)
+#define _gbDiagStop() ((void) 0)
+#endif
+#endif
