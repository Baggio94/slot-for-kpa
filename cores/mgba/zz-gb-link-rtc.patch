+			/ gbCore->frequency(gbCore);
+		gbCore->rtc.override = RTC_FAKE_EPOCH;
+		gbCore->rtc.value = gb->memory.rtcLastLatch
+			? (int64_t) gb->memory.rtcLastLatch * 1000LL - ranMs
+			: LINK_RTC_EPOCH_MS;
+	}
