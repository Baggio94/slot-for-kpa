 #include <sys/socket.h>
 #include <sys/ioctl.h>
 #include <netinet/in.h>
+#include <netinet/tcp.h>
 #include <netdb.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <time.h>
+#endif
+
+#ifndef _WIN32
+/* Every byte is a request and its answer, so Nagle must not hold it back, and
+ * the emulation thread must never wait forever on a console that left the
+ * network: a transfer that gets no answer reads as an unplugged cable (0xFF). */
+static void tuneSocket(int fd)
+{
+	int one = 1;
+	struct timeval wait = { 2, 0 };
+	setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+	setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &wait, sizeof(wait));
+	setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &wait, sizeof(wait));
+}
+
+/* connect() with a bound, on the emulation thread. */
+static int connectWithin(int fd, const struct sockaddr* addr, socklen_t len, int ms)
+{
+	int flags = fcntl(fd, F_GETFL, 0);
+	fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+	int rc = connect(fd, addr, len);
+	if (rc < 0 && errno == EINPROGRESS) {
+		struct pollfd pfd = { fd, POLLOUT, 0 };
+		int error = 0;
+		socklen_t size = sizeof(error);
+		rc = -1;
+		if (poll(&pfd, 1, ms) == 1 &&
+			getsockopt(fd, SOL_SOCKET, SO_ERROR, &error, &size) == 0 && error == 0) {
+			rc = 0;
+		} else if (error) {
+			errno = error;
+		} else {
+			errno = ETIMEDOUT;
+		}
+	}
+	fcntl(fd, F_SETFL, flags);
+	return rc;
+}
 #endif
 
