+/* Shift the next `count` bits of the received byte into SB, after the `done`
+ * bits already shifted in. Taking the top bits again on every partial update
+ * left SB wrong whenever a game read SB or SC during a transfer. */
+static unsigned char serialShiftIn(unsigned sb, unsigned received, int done, int count) {
+	unsigned next = ((received << done) & 0xFF) >> (8 - count);
+	return ((sb << count) | next) & 0xFF;
+}
